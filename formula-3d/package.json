{
  "name": "apice-gp",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "description": "ÁPICE GP — juego de monoplazas en 3D para navegador (Vite + TypeScript + Three.js).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node e2e/smoke.mjs",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && vite build"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "playwright-core": "^1.56.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
